#!/usr/bin/env python3
"""Print GnuPG keys as keysigning slips, rendered as Typst source.

`gpg-key2typ` is a reimplementation of gpg-key2ps(1) from the Debian
signing-party package.  Like the original, it asks gpg for the requested
keys, lays their fingerprints and User IDs out on paper slips, and repeats
each slip to fill a sheet.  Unlike the original, it writes Typst markup to
standard output instead of PostScript, so the result can be compiled and
restyled with Typst:

    gpg-key2typ -p a4 Alice Bob > slips.typ
    typst compile slips.typ slips.pdf

The slip geometry and the command line options follow gpg-key2ps, but
the content is labelled the way gpg itself prints keys: algorithm and
curve names (`rsa4096`, `ed25519`, `cv25519`), `YYYY-MM-DD` (UTC)
creation dates, and capability flags (`[SC]`, `[E]`).  `-i`, `-o`, and
`--qr` are extensions.
"""

from __future__ import annotations

import argparse
import os
import re
import shutil
import subprocess
import sys
import time
from collections.abc import Sequence
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any, TextIO

PROGRAM = "gpg-key2typ"
VERSION = "0.1.0"

MM_PER_PT = 25.4 / 72.0

# Slip geometry, in points (1/72 inch), following gpg-key2ps: the label,
# key summary, creation stamp, and comment columns.  User ID values sit in
# the summary column (x = 70), unlike gpg-key2ps, whose far-right column
# would squeeze long UIDs.
LINE_HEIGHT_PT = 10.0
SLIP_PAD_Y_PT = 5.0
SLIP_STROKE_PT = 0.5
# Clear space kept before the next field when a run is condensed.
FIELD_GAP_PT = 2.0
PAGE_MARGIN_PT = 7 * 72 / 25.4
LABEL_X_PT = 50.0
VALUE_X_PT = 70.0
DATE_X_PT = 150.0
COMMENT_X_PT = 200.0
RULE_X_PT = 30.0
RULE_STROKE_PT = 0.5

# Fingerprint QR codes (the `--qr` extension).  A QR lives in the left
# gutter of a key block, left of the first text position (50pt), so it
# never overlaps the upstream line layout.
QR_PACKAGE = "@preview/qrypst:0.1.1"
QR_SIZE_PT = 48.0
QR_X_PT = 1.0
QR_ECC = "M"
QR_QUIET = 4
# Byte-mode capacities of QR versions 1-10 at error-correction level M.
QR_BYTE_CAPACITY_M = (14, 26, 42, 62, 84, 106, 122, 152, 180, 213)

# Public key algorithms, named the way gpg prints them.  ECC keys are
# named by their curve from the colon listing, so these entries cover
# records without one; unknown numbers print as "unknown_N" like gpg's
# own fallback.
ALGORITHMS = {
    1: "rsa",
    2: "rsa",
    3: "rsa",
    16: "elg",
    17: "dsa",
    18: "ecdh",
    19: "ecdsa",
    20: "xxx",
    22: "eddsa",
    25: "x25519",
    26: "x448",
    27: "ed25519",
    28: "ed448",
}

# Algorithms whose key size is printed after the name.  The size of an
# ECC key follows from its curve, so those names stand alone.
ALGORITHMS_WITH_BITS = frozenset({1, 2, 3, 16, 17, 18, 19, 20, 22})

# Key capabilities, as gpg labels them in its key listings (`[SC]`,
# `[E]`).  The colon listing carries the key's own capabilities in field
# 12 as lower-case letters; gpg prints them in this order.
CAPABILITIES = (
    ("s", "S"),
    ("c", "C"),
    ("e", "E"),
    ("a", "A"),
    ("r", "R"),
    ("t", "T"),
    ("g", "G"),
)

REVOKED_STYLES = ("hide", "show", "grey", "note", "strike")

# Records gpg can emit that carry nothing for a slip.
SKIPPED_RECORDS = frozenset({"tru", "uat", "spk", "grp", "cfg", "rvk"})

# Fallback paper sizes in portrait millimetres.  paperconf is preferred
# when installed; this table covers the common names without libpaper and
# keeps `-p` deterministic.
PAPERS_MM = {
    "a2": (420.0, 594.0),
    "a3": (297.0, 420.0),
    "a4": (210.0, 297.0),
    "a5": (148.0, 210.0),
    "a6": (105.0, 148.0),
    "b4": (250.0, 353.0),
    "b5": (176.0, 250.0),
    "letter": (215.9, 279.4),
    "legal": (215.9, 355.6),
    "ledger": (279.4, 431.8),
    "tabloid": (279.4, 431.8),
    "executive": (184.15, 266.7),
}


class PaperSizeError(Exception):
    """A paper size could not be resolved."""


def mm_to_pt(mm: float) -> float:
    return mm / MM_PER_PT


def pt_to_mm(pt: float) -> float:
    return pt * MM_PER_PT


@dataclass(frozen=True)
class Paper:
    """A sheet in portrait orientation, measured in points."""

    width_pt: float
    height_pt: float


@dataclass(frozen=True)
class Run:
    """A text fragment printed at an absolute x offset inside a slip."""

    x: float
    text: str


@dataclass
class Line:
    """One text line (or separator rule) of a slip."""

    kind: str  # "pub", "fpr", "uid", "sub", or "rule"
    runs: list[Run] = field(default_factory=list)
    revoked: bool = False


@dataclass
class Key:
    lines: list[Line] = field(default_factory=list)
    fingerprint: str = ""


@dataclass(frozen=True)
class Layout:
    """How the slips tile onto one sheet."""

    page_width_pt: float  # portrait short edge
    page_height_pt: float  # portrait long edge
    columns: int
    slip_width_pt: float
    slip_height_pt: float
    rows: int

    @property
    def slip_count(self) -> int:
        return self.rows * self.columns


# --------------------------------------------------------------------------
# Paper sizes
# --------------------------------------------------------------------------


def resolve_paper(name: str | None) -> Paper:
    """Resolve the requested sheet size; the default is A4.

    Named sizes are first looked up in the built-in table, then passed to
    libpaper's paperconf when it is installed.
    """
    if name is None:
        width_mm, height_mm = PAPERS_MM["a4"]
        return Paper(mm_to_pt(width_mm), mm_to_pt(height_mm))
    if size := PAPERS_MM.get(name.lower()):
        width_mm, height_mm = size
        return Paper(mm_to_pt(width_mm), mm_to_pt(height_mm))

    paperconf = shutil.which("paperconf")
    if paperconf:
        env = dict(os.environ, PAPERSIZE=name)
        try:
            return Paper(
                _paperconf_dimension(paperconf, "-w", env),
                _paperconf_dimension(paperconf, "-h", env),
            )
        except (OSError, ValueError):
            pass

    raise PaperSizeError(f'unknown paper size "{name}"')


def _paperconf_dimension(paperconf: str, option: str, env: dict[str, str]) -> float:
    result = subprocess.run(
        [paperconf, option],
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        check=False,
    )
    return float(result.stdout.strip().replace(",", "."))


# --------------------------------------------------------------------------
# gpg output
# --------------------------------------------------------------------------


def list_keys(gnupgbin: str, patterns: Sequence[str]) -> bytes:
    """Run gpg and return its colon-separated key listing on stdout."""
    result = subprocess.run(
        [gnupgbin, "--list-key", "--with-fingerprint", "--with-colons", *patterns],
        stdout=subprocess.PIPE,
        check=False,
    )
    return result.stdout


def show_keys(gnupgbin: str, source: str) -> bytes:
    """List the keys in a file or on stdin (`-`) without importing them."""
    result = subprocess.run(
        [gnupgbin, "--show-keys", "--with-fingerprint", "--with-colons", source],
        stdout=subprocess.PIPE,
        check=False,
    )
    return result.stdout


def parse_keys(colon_output: bytes, revoked_style: str, show_subkeys: bool) -> list[Key]:
    """Turn `gpg --with-colons` output into printable keys."""
    keys: list[Key] = []
    key: Key | None = None
    in_subkey = False

    for raw_line in colon_output.splitlines():
        fields = raw_line.split(b":")
        record = fields[0].decode("ascii", "replace")
        if record in SKIPPED_RECORDS:
            continue
        if record == "pub":
            key = Key()
            keys.append(key)
            in_subkey = False
            key.lines.append(_pub_line(fields))
        elif record == "fpr":
            if key is not None and not in_subkey:
                key.fingerprint = _text_field(fields, 9).strip().upper()
                key.lines.append(
                    Line(
                        "fpr",
                        [
                            Run(
                                VALUE_X_PT,
                                "Key fingerprint = " + format_fingerprint(key.fingerprint),
                            )
                        ],
                    )
                )
        elif record == "uid":
            if key is not None and (line := _uid_line(fields, revoked_style)):
                key.lines.append(line)
        elif record == "sub":
            in_subkey = True
            if key is not None and show_subkeys and (line := _sub_line(fields, revoked_style)):
                key.lines.append(line)

    return keys


def _pub_line(fields: list[bytes]) -> Line:
    runs = [
        Run(LABEL_X_PT, "pub"),
        Run(VALUE_X_PT, _key_summary(fields)),
        Run(DATE_X_PT, _stamp(fields)),
    ]
    if comment := _text_field(fields, 9):
        runs.append(Run(COMMENT_X_PT, comment))
    return Line("pub", runs)


def _uid_line(fields: list[bytes], revoked_style: str) -> Line | None:
    revoked = _is_revoked(fields)
    if revoked and revoked_style == "hide":
        return None
    return Line(
        "uid",
        [Run(LABEL_X_PT, "uid"), Run(VALUE_X_PT, _text_field(fields, 9))],
        revoked,
    )


def _sub_line(fields: list[bytes], revoked_style: str) -> Line | None:
    revoked = _is_revoked(fields)
    if revoked and revoked_style == "hide":
        return None
    runs = [
        Run(LABEL_X_PT, "sub"),
        Run(VALUE_X_PT, _key_summary(fields)),
        Run(DATE_X_PT, _stamp(fields)),
    ]
    return Line("sub", runs, revoked)


def _key_summary(fields: list[bytes]) -> str:
    """`curve/KEYID` or `algo+bits/KEYID`, e.g. `ed25519/DF95CC16`.

    ECC keys are named by their curve, as gpg prints them, and the
    key size is left out because it follows from the curve.
    """
    key_id = _text_field(fields, 4)[-8:]
    if curve := _text_field(fields, 16).strip():
        return f"{curve}/{key_id}"
    try:
        algorithm = int(_text_field(fields, 3))
    except ValueError:
        return f"xxx{_text_field(fields, 2)}/{key_id}"
    name = ALGORITHMS.get(algorithm, f"unknown_{algorithm}")
    if algorithm in ALGORITHMS_WITH_BITS:
        name += _text_field(fields, 2)
    return f"{name}/{key_id}"


def _stamp(fields: list[bytes]) -> str:
    """`YYYY-MM-DD [CAPS]`, the creation date and the key capabilities."""
    date = format_date(_text_field(fields, 5))
    usage = _key_usage(fields)
    return " ".join(part for part in (date, f"[{usage}]" if usage else "") if part)


def _key_usage(fields: list[bytes]) -> str:
    """The key's own capabilities, e.g. `SC` or `E`, as gpg labels them."""
    raw = _text_field(fields, 11)
    return "".join(letter for flag, letter in CAPABILITIES if flag in raw)


def _is_revoked(fields: list[bytes]) -> bool:
    return len(fields) > 1 and fields[1].startswith(b"r")


def _text_field(fields: list[bytes], index: int) -> str:
    raw = fields[index] if index < len(fields) else b""
    # gpg escapes bytes that are not safely printable as \xNN.  Undo the
    # escapes first, then decode the result as UTF-8 so Typst gets Unicode.
    unescaped = re.sub(rb"\\x([0-9A-Fa-f]{2})", lambda match: bytes([int(match.group(1), 16)]), raw)
    return unescaped.decode("utf-8", "replace")


def format_fingerprint(fingerprint: str) -> str:
    """Group a fingerprint the way gpg-key2ps does.

    v3 (32 hex) prints as pairs, v4 and v6 as quads; the halves are
    separated by two spaces.
    """
    if len(fingerprint) == 32:
        groups = [fingerprint[i : i + 2] for i in range(0, 32, 2)]
        return " ".join(groups[:8]) + "  " + " ".join(groups[8:])
    groups = [fingerprint[i : i + 4] for i in range(0, len(fingerprint), 4)]
    if len(fingerprint) in (40, 64):
        half = len(groups) // 2
        return " ".join(groups[:half]) + "  " + " ".join(groups[half:])
    return " ".join(groups)


def format_date(epoch: str) -> str:
    """Print gpg's creation timestamp as the `YYYY-MM-DD` date gpg shows.

    gpg stores and prints dates in UTC; anything that is not a plain
    Unix timestamp (an ISO 8601 stamp from a future gpg, an empty
    field) is passed through unchanged.
    """
    try:
        return time.strftime("%Y-%m-%d", time.gmtime(int(epoch)))
    except (ValueError, OverflowError, OSError):
        return epoch


# --------------------------------------------------------------------------
# Typst rendering
# --------------------------------------------------------------------------


def qr_geometry(payload: str) -> tuple[float, float]:
    """Return `(module_mm, box_pt)` for a payload encoded by qrypst.

    qrypst picks the smallest version that fits and draws `quiet` modules
    of white margin around it; `box_pt` is the exact printed size.
    """
    size = len(payload.encode("utf-8"))
    version = next(
        (index for index, capacity in enumerate(QR_BYTE_CAPACITY_M, start=1) if size <= capacity),
        None,
    )
    if version is None:
        raise ValueError("fingerprint is too long for a QR code")
    modules = 21 + 4 * (version - 1) + 2 * QR_QUIET
    module_mm = round(pt_to_mm(QR_SIZE_PT) / modules, 6)
    return module_mm, mm_to_pt(module_mm * modules)


def key_height_pt(key: Key, with_qr: bool) -> float:
    height = len(key.lines) * LINE_HEIGHT_PT
    if with_qr and key.fingerprint:
        _, qr_height = qr_geometry(key.fingerprint)
        height = max(height, qr_height)
    return height


def compute_layout(keys: Sequence[Key], paper: Paper, one_column: bool, with_qr: bool, stderr: TextIO) -> Layout:
    columns = 1 if one_column else 2
    content_width_pt = paper.height_pt - 2 * PAGE_MARGIN_PT
    content_height_pt = paper.width_pt - 2 * PAGE_MARGIN_PT
    slip_width_pt = content_width_pt / columns
    slip_height_pt = (
        2 * SLIP_PAD_Y_PT + sum(key_height_pt(key, with_qr) for key in keys) + (len(keys) - 1) * LINE_HEIGHT_PT
    )
    rows = int(content_height_pt // slip_height_pt)
    if rows < 1:
        rows = 1
        print(
            "Warning: the slip is taller than the paper; it will overflow.",
            file=stderr,
        )
    return Layout(paper.width_pt, paper.height_pt, columns, slip_width_pt, slip_height_pt, rows)


def render_document(keys: Sequence[Key], layout: Layout, revoked_style: str, with_qr: bool) -> str:
    """Render the complete, self-contained Typst document."""
    lines: list[str] = []
    add = lines.append

    add(f"// Generated by {PROGRAM} {VERSION}; do not edit, regenerate instead.")
    if with_qr:
        add(f'#import "{QR_PACKAGE}": qr')
    add(
        f"#set page(width: {pt_to_mm(layout.page_height_pt):.3f}mm, "
        f"height: {pt_to_mm(layout.page_width_pt):.3f}mm, "
        f"margin: {pt_to_mm(PAGE_MARGIN_PT):.3f}mm, fill: white)"
    )
    add('#set text(font: "New Computer Modern", size: 9pt, fill: black)')
    add("#set par(leading: 0.1em, spacing: 0pt)")
    add("#set block(spacing: 0pt)")
    add("")
    add(f"#let lh = {LINE_HEIGHT_PT:g}pt")
    add(f"#let slip-w = {layout.slip_width_pt:.4f}pt")
    add(f"#let slip-h = {layout.slip_height_pt:.4f}pt")
    add("#let fit(avail, body) = context {")
    add("  let natural = measure(box(body)).width")
    add("  if natural > avail {")
    add("    scale(x: 100% * (avail / natural), reflow: true, origin: left, box(body))")
    add("  } else {")
    add("    box(body)")
    add("  }")
    add("}")
    add("#let put(x, avail, body) = place(top + left, dx: x, dy: 0pt, fit(avail, body))")
    add("#let row(body) = block(width: 100%, height: lh, body)")
    add(
        "#let rule-row = block(width: 100%, height: lh, "
        f"place(dx: {RULE_X_PT:g}pt, dy: lh / 2 - {RULE_STROKE_PT / 2:g}pt, "
        f"line(length: slip-w - {2 * RULE_X_PT:g}pt, stroke: {RULE_STROKE_PT:g}pt)))"
    )
    add("")
    add("#let slip = block(")
    add(f"  width: slip-w, height: slip-h, stroke: {SLIP_STROKE_PT:g}pt,")
    add(f"  inset: (y: {SLIP_PAD_Y_PT:g}pt),")
    add("  stack(spacing: 0pt,")
    for index, key in enumerate(keys):
        if index:
            add("    rule-row,")
        add(
            _key_code(
                key,
                with_qr,
                revoked_style,
                indent="    ",
                slip_width_pt=layout.slip_width_pt,
            )
            + ","
        )
    add("  ),")
    add(")")
    add("")
    columns = ", ".join("slip-w" for _ in range(layout.columns))
    rows = ", ".join("slip-h" for _ in range(layout.rows))
    add(f"#grid(columns: ({columns}), rows: ({rows}), inset: 0pt,")
    add(f"  ..range({layout.slip_count}).map(_ => slip))")
    return "\n".join(lines) + "\n"


def _key_code(key: Key, with_qr: bool, revoked_style: str, indent: str, slip_width_pt: float) -> str:
    height = key_height_pt(key, with_qr)
    rows = f",\n{indent}  ".join(_row_code(line, revoked_style, slip_width_pt) for line in key.lines)
    body = f"stack(spacing: 0pt,\n{indent}  {rows},\n{indent})"

    if with_qr and key.fingerprint:
        module_mm, _ = qr_geometry(key.fingerprint)
        body += (
            f" + place(top + left, dx: {QR_X_PT:g}pt, dy: 0pt, "
            f"qr({_typst_string(key.fingerprint)}, module: {module_mm:.6f}mm, "
            f'ecc: "{QR_ECC}", quiet: {QR_QUIET}))'
        )

    return f"{indent}block(width: 100%, height: {height:.4f}pt, {body})"


def _row_code(line: Line, revoked_style: str, slip_width_pt: float) -> str:
    if line.kind == "rule":
        return "rule-row"

    runs = list(line.runs)
    grey = line.revoked and revoked_style == "grey"
    if line.revoked and revoked_style == "note" and runs:
        runs[-1] = Run(runs[-1].x, runs[-1].text + " [revoked]")

    pieces = []
    for index, run in enumerate(runs):
        fill = "fill: luma(50%), " if grey else ""
        # Text is condensed to fit the space up to the next field, or to
        # the slip edge for the last one, instead of running into it.
        limit = runs[index + 1].x if index + 1 < len(runs) else slip_width_pt
        avail = max(limit - run.x - FIELD_GAP_PT, 1.0)
        pieces.append(f"put({run.x:g}pt, {avail:.4f}pt, text({fill}{_typst_string(run.text)}))")
    if line.revoked and revoked_style == "strike":
        pieces.append(
            f"place(top + left, dx: {RULE_X_PT:g}pt, dy: lh / 2 - {RULE_STROKE_PT / 2:g}pt, "
            f"line(length: slip-w - {2 * RULE_X_PT:g}pt, stroke: {RULE_STROKE_PT:g}pt))"
        )
    return "row(" + " + ".join(pieces) + ")"


_STRING_ESCAPES = {"\\": "\\\\", '"': '\\"', "\n": "\\n", "\r": "\\r", "\t": "\\t"}


def _typst_string(value: str) -> str:
    """A Typst string literal: only quote and backslash need escaping."""
    escaped = "".join(_STRING_ESCAPES.get(char, char if char.isprintable() else " ") for char in value)
    return f'"{escaped}"'


# --------------------------------------------------------------------------
# Command line
# --------------------------------------------------------------------------


class Parser(argparse.ArgumentParser):
    """An ArgumentParser that reports to the streams passed to run().

    argparse ordinarily writes to the process stdout/stderr and exits with
    status 2 on usage errors; run() injects its streams for testability and
    keeps gpg-key2ps's status 1, so both are overridden.
    """

    def __init__(self, stdout: TextIO, stderr: TextIO, **kwargs: Any) -> None:
        super().__init__(**kwargs)
        self._stdout = stdout
        self._stderr = stderr

    def _print_message(self, message: str | None, file: TextIO | None = None) -> None:
        if not message:
            return
        if file is None or file is sys.stdout:
            self._stdout.write(message)
        elif file is sys.stderr:
            self._stderr.write(message)
        else:
            file.write(message)

    def error(self, message: str) -> None:
        self.print_usage(self._stderr)
        self.exit(1, f"{self.prog}: error: {message}\n")


def build_parser(stdout: TextIO, stderr: TextIO) -> Parser:
    parser = Parser(
        stdout,
        stderr,
        prog=PROGRAM,
        description="Print OpenPGP keysigning slips as Typst source.",
        add_help=False,
    )
    parser.add_argument("-h", "--help", action="help", help="print this help and exit")
    parser.add_argument(
        "-v", "--version", action="version", version=f"{PROGRAM} {VERSION}", help="print version and exit"
    )
    parser.add_argument("-p", "--paper-size", metavar="NAME", help="paper size (default: a4)")
    parser.add_argument(
        "-i",
        "--input",
        metavar="FILE",
        help="read keys from FILE instead of the keyring (use - for stdin)",
    )
    parser.add_argument("-o", "--output", metavar="FILE", help="write the Typst source to FILE instead of stdout")
    parser.add_argument("-s", "--show-subkeys", action="store_true", help="print subkey information on the slips")
    parser.add_argument(
        "-r",
        "--revoked-style",
        metavar="STYLE",
        choices=REVOKED_STYLES,
        default="hide",
        help="how to mark revoked User IDs and subkeys (default: hide)",
    )
    parser.add_argument("-1", action="store_true", dest="one_column", help="print one column of slips instead of two")
    parser.add_argument("--qr", action="store_true", help="add a QR code with the fingerprint to each key block")
    parser.add_argument(
        "patterns",
        metavar="keyid-or-name",
        nargs="*",
        help="keys to print, as accepted by gpg --list-keys",
    )
    return parser


def run(argv: Sequence[str], stdout: TextIO, stderr: TextIO) -> int:
    parser = build_parser(stdout, stderr)
    try:
        options = parser.parse_intermixed_args(argv)
        if options.input is None and not options.patterns:
            parser.error("pass keyid-or-name patterns or --input FILE")
        if options.input is not None and options.patterns:
            parser.error("keyid-or-name patterns cannot be combined with --input")
    except SystemExit as error:
        return int(error.code or 0)

    try:
        paper = resolve_paper(options.paper_size)
    except PaperSizeError as error:
        print(f"{PROGRAM}: {error}", file=stderr)
        return 1

    gnupgbin = os.environ.get("GNUPGBIN", "gpg")
    try:
        if options.input is not None:
            colon_output = show_keys(gnupgbin, options.input)
        else:
            colon_output = list_keys(gnupgbin, options.patterns)
    except FileNotFoundError:
        print(f'{PROGRAM}: cannot run "{gnupgbin}"', file=stderr)
        return 1

    keys = parse_keys(colon_output, options.revoked_style, options.show_subkeys)
    if not keys:
        print("No public key found.", file=stderr)
        return 1

    try:
        layout = compute_layout(keys, paper, options.one_column, options.qr, stderr)
        document = render_document(keys, layout, options.revoked_style, options.qr)
    except ValueError as error:
        print(f"{PROGRAM}: {error}", file=stderr)
        return 1

    if options.output:
        try:
            Path(options.output).write_text(document, encoding="utf-8")
        except OSError as error:
            print(f"{PROGRAM}: cannot write {options.output!r}: {error.strerror}", file=stderr)
            return 1
    else:
        stdout.write(document)
    return 0


def main() -> int:
    return run(sys.argv[1:], sys.stdout, sys.stderr)


if __name__ == "__main__":
    sys.exit(main())
